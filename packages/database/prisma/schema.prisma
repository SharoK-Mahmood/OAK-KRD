generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  PUBLISHER
  ADMIN
}

enum ContentType {
  NEWS
  ARTICLE
  BOOK
  EBOOK
  AUDIOBOOK
  PRESS_RELEASE
  REPORT
  RESEARCH
  PODCAST
  GALLERY
}

enum ContentFormat {
  TEXT
  PDF
  EPUB
  AUDIO
  VIDEO
  SUMMARY
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Locale {
  ku
  ar
  en
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          Role      @default(READER)
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   OrganizationMember[]
  follows       Follow[]           @relation("Follower")
  followedBy    Follow[]           @relation("Following")
  authored      Content[]          @relation("ContentAuthor")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameKu      String?
  nameAr      String?
  description String?  @db.Text
  logoUrl     String?
  website     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  OrganizationMember[]
  contents Content[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("editor") // owner | editor | viewer
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

/// Canonical work: one piece of knowledge that can have many language/format variants
model Content {
  id             String      @id @default(cuid())
  slug           String
  type           ContentType
  title          String
  subtitle       String?
  coverImageUrl  String?
  isPaid         Boolean     @default(false)
  priceCents     Int?
  currency       String      @default("USD")
  authorId       String?
  organizationId String?
  /// Shared key for podcast shows (e.g. "hewali-nwener"). Episodes with the same value belong together.
  seriesSlug     String?
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  author       User?         @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  variants     ContentVariant[]
  tags         ContentTag[]

  @@unique([organizationId, slug])
  @@index([type, publishedAt])
  @@index([authorId])
  @@index([seriesSlug, publishedAt])
  @@map("contents")
}

/// A specific locale + format rendering of a Content item
model ContentVariant {
  id              String        @id @default(cuid())
  contentId       String
  locale          Locale
  format          ContentFormat @default(TEXT)
  status          ContentStatus @default(DRAFT)
  title           String
  summary         String?       @db.Text
  body            String?       @db.Text
  /// Source variant this was derived from (translation, audio, summary, etc.)
  parentVariantId String?
  wordCount       Int?
  durationSeconds Int?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  content       Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parentVariant ContentVariant?  @relation("VariantDerivatives", fields: [parentVariantId], references: [id], onDelete: SetNull)
  derivatives   ContentVariant[] @relation("VariantDerivatives")
  assets        MediaAsset[]

  @@unique([contentId, locale, format])
  @@index([locale, status])
  @@index([parentVariantId])
  @@map("content_variants")
}

model MediaAsset {
  id        String   @id @default(cuid())
  variantId String
  kind      String // cover | pdf | epub | audio | video | thumbnail
  url       String
  mimeType  String?
  sizeBytes Int?
  meta      Json?
  createdAt DateTime @default(now())

  variant ContentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("media_assets")
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  nameKu   String?
  nameAr   String?
  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String
  tagId     String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("content_tags")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}
